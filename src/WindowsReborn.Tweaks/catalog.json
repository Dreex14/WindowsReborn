  {"id": "permissions.location", "category": "permissions", "risk": 2, "choices": ["allow", "apps", "all"], "settings": [{"hive": "HKLM", "key": "@consent/location", "name": "Value", "type": "string", "default": "Allow", "values": {"allow": "Allow", "apps": "Allow", "all": "Deny"}}, {"key": "@consent/location", "name": "Value", "type": "string", "default": "Allow", "values": {"allow": "Allow", "apps": "Deny"}}], "es": {"title": "Ubicación", "desc": "Qué apps pueden usar: ubicación. «Bloqueado en todo el equipo» es el interruptor «Acceso a…» de Configuración; «Bloqueado para las apps», el de «Permitir que las aplicaciones accedan…».", "choices": {"allow": "Permitido", "apps": "Bloqueado para las apps", "all": "Bloqueado en todo el equipo"}, "warn": "Bloquearla en todo el equipo desactiva la zona horaria automática y «Encontrar mi dispositivo»."}, "en": {"title": "Location", "desc": "Which apps can use: location. \"Blocked for the whole PC\" is the \"… access\" switch in Settings; \"Blocked for apps\" is \"Let apps access…\".", "choices": {"allow": "Allowed", "apps": "Blocked for apps", "all": "Blocked for the whole PC"}, "warn": "Blocking it for the whole PC turns off automatic time zone and \"Find my device\"."}},
