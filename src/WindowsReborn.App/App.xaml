<Application x:Class="WindowsReborn.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:infra="clr-namespace:WindowsReborn.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
            <infra:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
            <infra:NullToVisibilityConverter x:Key="NullToVis" />
            <infra:NullToVisibilityConverter x:Key="InvNullToVis" Invert="True" />
            <infra:InverseBoolConverter x:Key="InvBool" />
            <infra:BytesConverter x:Key="Bytes" />

            <!-- Paleta propia -->
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7C5CFF" Offset="0" />
                <GradientStop Color="#2F8CFF" Offset="0.55" />
                <GradientStop Color="#00C2FF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5B3FD9" Offset="0" />
                <GradientStop Color="#2563EB" Offset="0.6" />
                <GradientStop Color="#0891B2" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PrivacyGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F766E" Offset="0" />
                <GradientStop Color="#0E7490" Offset="0.6" />
                <GradientStop Color="#1D4ED8" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AccentSoft" Color="#337C5CFF" />
            <SolidColorBrush x:Key="AccentStrong" Color="#8B74FF" />
            <SolidColorBrush x:Key="SafeBrush" Color="#2EB872" />
            <SolidColorBrush x:Key="SafeSoft" Color="#262EB872" />
            <SolidColorBrush x:Key="ModerateBrush" Color="#F5A524" />
            <SolidColorBrush x:Key="ModerateSoft" Color="#26F5A524" />
            <SolidColorBrush x:Key="AdvancedBrush" Color="#F2545B" />
            <SolidColorBrush x:Key="AdvancedSoft" Color="#26F2545B" />
            <SolidColorBrush x:Key="InfoSoft" Color="#262F8CFF" />
            <SolidColorBrush x:Key="InfoBrush" Color="#5AA2FF" />

            <!-- Tipografía -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,6,0,22" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CaptionTrim" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="OnHeroTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="OnHeroText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#E6FFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Botones -->
            <Style x:Key="GradientButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Glow" CornerRadius="11" Background="{StaticResource AccentGradient}" Opacity="0" Margin="-2">
                                    <Border.Effect><BlurEffect Radius="14" /></Border.Effect>
                                </Border>
                                <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource AccentGradient}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" />
                                </Border>
                                <Border x:Name="Focus" CornerRadius="12" BorderBrush="White" BorderThickness="2" Margin="-3" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Glow" Property="Opacity" Value="0.55" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SoftButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentStrong}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="OnHeroButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
                <Setter Property="Background" Value="#33FFFFFF" />
                <Setter Property="BorderBrush" Value="#55FFFFFF" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="WhiteButton" TargetType="Button">
                <Setter Property="Foreground" Value="#1E1B4B" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10" Background="White" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#1E1B4B" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#EDEBFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Superficies -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="22,18" />
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>
            <Style x:Key="Hero" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource HeroGradient}" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="28,24" />
                <Setter Property="Margin" Value="0,0,0,18" />
            </Style>
            <Style x:Key="IconBubble" TargetType="Border">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            </Style>

            <!-- Etiquetas -->
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="RiskChip" TargetType="Border" BasedOn="{StaticResource Chip}">
                <Setter Property="Background" Value="{StaticResource SafeSoft}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Risk}" Value="Moderate">
                        <Setter Property="Background" Value="{StaticResource ModerateSoft}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Risk}" Value="Advanced">
                        <Setter Property="Background" Value="{StaticResource AdvancedSoft}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RiskChipText" TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                <Setter Property="Foreground" Value="{StaticResource SafeBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Risk}" Value="Moderate">
                        <Setter Property="Foreground" Value="{StaticResource ModerateBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Risk}" Value="Advanced">
                        <Setter Property="Foreground" Value="{StaticResource AdvancedBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Pestañas de filtro con forma de píldora -->
            <Style x:Key="PillTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="16" Padding="14,6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <ContentPresenter x:Name="Cp" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentStrong}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGradient}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Casilla circular con palomita -->
            <ControlTemplate x:Key="CheckMark" TargetType="Control">
                <Grid Width="22" Height="22">
                    <Ellipse x:Name="Ring" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5" Fill="Transparent" />
                    <Ellipse x:Name="Fill" Fill="{StaticResource AccentGradient}" Visibility="Collapsed" />
                    <Path x:Name="Tick" Data="M6,11.5 L9.5,15 L16,7.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                </Grid>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                        <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Tarjeta seleccionable (programas, elementos de copia) -->
            <Style x:Key="SelectCard" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Bd" CornerRadius="12" Padding="14,12" BorderThickness="1.5"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center" />
                                    <Control Grid.Column="1" Template="{StaticResource CheckMark}" VerticalAlignment="Top" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentStrong}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentStrong}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Avatar con iniciales -->
            <Style x:Key="Avatar" TargetType="Border">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="CornerRadius" Value="11" />
            </Style>
            <Style x:Key="AvatarText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Navegación lateral -->
            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="GroupName" Value="Nav" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Margin" Value="10,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Padding="14,0" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#557C5CFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Barra de progreso fina con degradado -->
            <Style x:Key="SlimProgress" TargetType="ProgressBar">
                <Setter Property="Height" Value="8" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" CornerRadius="4" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PageScroll" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Padding" Value="36,14,36,28" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
