<UserControl x:Class="WindowsReborn.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure"
             xmlns:vm="clr-namespace:WindowsReborn.App.ViewModels">
    <Grid Margin="32,8,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr programs.title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr programs.subtitle}" Margin="0,0,0,12" />
        </StackPanel>

        <!-- Barra de acciones -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ui:Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Content="{l:Tr programs.add}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCommand}" />
            <ui:Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Content="{l:Tr programs.import}" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportListCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
            <ui:Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Content="{l:Tr programs.export}" Icon="{ui:SymbolIcon ArrowExportLtr24}" Command="{Binding ExportListCommand}" />
            <ui:Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Content="{l:Tr programs.check}" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
            <ui:Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Content="{l:Tr programs.download-selected}" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadSelectedCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
            <ui:Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Content="{l:Tr programs.prepare}" Icon="{ui:SymbolIcon BoxArrowUp24}" Command="{Binding PrepareForFormatCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
            <ui:Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Content="{l:Tr common.cancel}" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelCommand}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </WrapPanel>

        <StackPanel Grid.Row="2">
            <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="{l:Tr programs.no-winget}" Message="{l:Tr programs.no-winget-detail}"
                        Visibility="{Binding WingetAvailable, Converter={StaticResource InvBoolToVis}}" Margin="0,0,0,8" />
            <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="{l:Tr programs.backup-installers}" Message="{l:Tr programs.backup-installers-detail}"
                        Visibility="{Binding HasBackupInstallers, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
        </StackPanel>

        <!-- Lista -->
        <Grid Grid.Row="3">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" MaxWidth="460">
                <ui:SymbolIcon Symbol="Apps24" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" TextAlignment="Center" Text="{l:Tr programs.empty}" Margin="0,12,0,4" />
                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" Text="{l:Tr programs.empty-detail}" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                     Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProgramItem}">
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" />
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Margin="4,0,12,0" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <ui:SymbolIcon Symbol="{Binding TrustSymbol}" FontSize="14" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Style="{StaticResource CaptionTrim}" MaxWidth="420" ToolTip="{Binding TrustText}">
                                            <Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TrustText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}" Margin="0,2,0,0" />
                                    <ProgressBar Height="4" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding StateText}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding VersionText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Style="{StaticResource SmallButton}" Content="{l:Tr programs.download}" Icon="{ui:SymbolIcon ArrowDownload24}"
                                               IsEnabled="{Binding CanDownload}"
                                               Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <ui:Button Style="{StaticResource SmallButton}" Content="{l:Tr programs.install}" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                                               IsEnabled="{Binding CanInstall}"
                                               Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Globe24}" ToolTip="{l:Tr programs.open-homepage}"
                                               IsEnabled="{Binding HasHomepage}"
                                               Command="{Binding DataContext.OpenHomepageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Edit24}" ToolTip="{l:Tr common.edit}"
                                               Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:Tr common.delete}"
                                               Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" />
            <ui:Button Style="{StaticResource SmallButton}" HorizontalAlignment="Right" Content="{l:Tr programs.refresh}" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshInstalledCommand}" />
        </Grid>
    </Grid>
</UserControl>
