<UserControl x:Class="WindowsReborn.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure">
    <UserControl.Resources>
        <!-- Estado de cada tarjeta -->
        <Style x:Key="StateBorder" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Installed"><Setter Property="Background" Value="{StaticResource SafeSoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done"><Setter Property="Background" Value="{StaticResource SafeSoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="UpdateAvailable"><Setter Property="Background" Value="{StaticResource InfoSoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Working"><Setter Property="Background" Value="{StaticResource AccentSoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Background" Value="{StaticResource AdvancedSoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Manual"><Setter Property="Background" Value="{StaticResource ModerateSoft}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="StateChip">
            <Border Style="{StaticResource StateBorder}" Visibility="{Binding ShowState, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0" HorizontalAlignment="Left">
                <TextBlock Text="{Binding StateText}" Style="{StaticResource ChipText}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                        <Button Style="{StaticResource SoftButton}" Command="{Binding SaveConfigCommand}" Margin="0,0,8,0" ToolTip="{l:Tr section.save.hint}">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr section.save}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Command="{Binding LoadConfigCommand}" ToolTip="{l:Tr section.load.hint}">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr section.load}" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{l:Tr programs.title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{l:Tr programs.subtitle}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="-10,-12,0,12">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectRecommendedCommand}">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Star20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr programs.select.recommended}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="CheckmarkCircle20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr programs.select.all}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectNoneCommand}">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DismissCircle20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr programs.select.none}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding DetectCommand}" ToolTip="{l:Tr programs.detect}">
                            <ui:SymbolIcon Symbol="ArrowClockwise20" />
                        </Button>
                    </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,-8,0,14" Visibility="{Binding IsDetecting, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" />
                    <TextBlock Text="{l:Tr programs.detecting}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Catálogo por categorías -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource SelectCard}" Width="258" IsChecked="{Binding IsSelected}"
                                                      AutomationProperties.Name="{Binding Name}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid>
                                                        <Border Style="{StaticResource Avatar}" Background="{Binding Color, Converter={x:Static l:HexToBrushConverter.Instance}}"
                                                                Visibility="{Binding HasIcon, Converter={StaticResource InvBoolToVis}}">
                                                            <TextBlock Text="{Binding Monogram}" Style="{StaticResource AvatarText}" />
                                                        </Border>
                                                        <Border Style="{StaticResource IconTile}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                            <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CaptionTrim}" />
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StateChip}" />
                                                    </StackPanel>
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Mis programas de GitHub -->
                <Border Style="{StaticResource Card}" Margin="0,8,0,14">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource IconBubble}" DockPanel.Dock="Left">
                                <ui:SymbolIcon Symbol="Code24" Foreground="{StaticResource AccentStrong}" FontSize="20" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:Tr programs.github.title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{l:Tr programs.github.subtitle}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding GitHubUser, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr programs.github.user}">
                                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Person20" /></ui:TextBox.Icon>
                            </ui:TextBox>
                            <Button Grid.Column="1" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Command="{Binding SaveGitHubUserCommand}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowClockwise20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr programs.github.load}" /></StackPanel>
                            </Button>
                            <ui:TextBox Grid.Column="3" Text="{Binding NewRepo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr programs.github.repo}">
                                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Link20" /></ui:TextBox.Icon>
                            </ui:TextBox>
                            <Button Grid.Column="4" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Command="{Binding AddRepoCommand}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr common.add}" /></StackPanel>
                            </Button>
                        </Grid>

                        <CheckBox IsChecked="{Binding DesktopShortcut}" Content="{l:Tr programs.github.desktop}" Margin="0,12,0,0" />

                        <!-- Repos privados: cuenta conectada con un token -->
                        <Border CornerRadius="10" Padding="14,12" Margin="0,14,0,0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel Visibility="{Binding IsGitHubConnected, Converter={StaticResource InvBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="LockClosed20" Margin="0,0,8,0" Foreground="{StaticResource AccentStrong}" />
                                        <TextBlock Text="{l:Tr programs.github.private.title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{l:Tr programs.github.private.hint}" Style="{StaticResource Caption}" Margin="0,4,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:PasswordBox x:Name="TokenBox" PlaceholderText="{l:Tr programs.github.token}" />
                                        <Button Grid.Column="1" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="OnConnectGitHub"
                                                IsEnabled="{Binding GitHubConnecting, Converter={StaticResource InvBool}}">
                                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PlugConnected20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr programs.github.connect}" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="38" Margin="6,0,0,0" Command="{Binding OpenTokenPageCommand}">
                                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Open20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr programs.github.create-token}" /></StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <DockPanel Visibility="{Binding IsGitHubConnected, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding DisconnectGitHubCommand}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PlugDisconnected20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr programs.github.disconnect}" /></StackPanel>
                                    </Button>
                                    <ui:SymbolIcon Symbol="CheckmarkCircle20" Foreground="{StaticResource SafeBrush}" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Body}"
                                               Text="{Binding GitHubAccount, Converter={x:Static l:Format.Converter}, ConverterParameter=programs.github.connected}" />
                                </DockPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding GitHubLoading, Converter={StaticResource BoolToVis}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" />
                            <TextBlock Text="{l:Tr programs.github.loading}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding GitHubError}" Foreground="{StaticResource AdvancedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding GitHubError, Converter={StaticResource NullToVis}}" />

                        <ItemsControl ItemsSource="{Binding GitHubApps}" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource SelectCard}" Width="258" IsChecked="{Binding IsSelected}" ToolTip="{Binding Description}"
                                              AutomationProperties.Name="{Binding Name}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Border Style="{StaticResource Avatar}" Background="{StaticResource AccentGradient}"
                                                        Visibility="{Binding HasIcon, Converter={StaticResource InvBoolToVis}}">
                                                    <TextBlock Text="{Binding Monogram}" Style="{StaticResource AvatarText}" />
                                                </Border>
                                                <Border Style="{StaticResource IconTile}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                    <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="LockClosed12" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}" ToolTip="{l:Tr programs.github.private}" />
                                                    <TextBlock Text="{Binding Version}" Style="{StaticResource CaptionTrim}" />
                                                </StackPanel>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StateChip}" />
                                            </StackPanel>
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra de acción fija -->
        <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="36,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                               Text="{Binding SelectedCount, Converter={x:Static l:Format.Converter}, ConverterParameter=programs.selected-count}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}" />
                    <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding Progress}" Margin="0,6,24,0" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SoftButton}" Command="{Binding CancelCommand}" Margin="0,0,10,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Content="{l:Tr common.cancel}" />
                    <Button Style="{StaticResource GradientButton}" Command="{Binding InstallSelectedCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload20" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Tr programs.install-selected}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
