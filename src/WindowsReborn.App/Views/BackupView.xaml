<UserControl x:Class="WindowsReborn.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemCard">
            <CheckBox Style="{StaticResource SelectCard}" Width="300" IsChecked="{Binding IsSelected}" IsEnabled="{Binding Exists}"
                      AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBubble}">
                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" Foreground="{StaticResource AccentStrong}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Location}" Style="{StaticResource CaptionTrim}" ToolTip="{Binding Location}" />
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="6,0" VerticalAlignment="Top"
                            Command="{Binding RemoveCommand}" ToolTip="{l:Tr common.remove}"
                            Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Delete20" />
                    </Button>
                </Grid>
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
                <TextBlock Text="{l:Tr backup.title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{l:Tr backup.subtitle}" Style="{StaticResource PageSubtitle}" />

                <!-- Resultado -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource IconBubble}" VerticalAlignment="Top">
                            <Grid>
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource SafeBrush}" FontSize="22"
                                               Visibility="{Binding ResultOk, Converter={StaticResource BoolToVis}}" />
                                <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="{StaticResource AdvancedBrush}" FontSize="22"
                                               Visibility="{Binding ResultOk, Converter={StaticResource InvBoolToVis}}" />
                            </Grid>
                        </Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Command="{Binding OpenResultCommand}" VerticalAlignment="Center"
                                Visibility="{Binding ResultFolder, Converter={StaticResource NullToVis}}">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr common.open-folder}" /></StackPanel>
                        </Button>
                        <StackPanel Margin="14,0,12,0">
                            <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding ResultText, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Configuración de apps -->
                <DockPanel Margin="0,4,0,10">
                    <ui:SymbolIcon Symbol="Apps24" FontSize="20" Margin="0,0,10,0" Foreground="{StaticResource AccentStrong}" />
                    <StackPanel>
                        <TextBlock Text="{l:Tr backup.group.apps}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Tr backup.group.apps.hint}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding AppItems}" ItemTemplate="{StaticResource ItemCard}" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Carpetas personales -->
                <DockPanel Margin="0,4,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Command="{Binding AddFolderCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderAdd20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr backup.add-folder}" /></StackPanel>
                    </Button>
                    <ui:SymbolIcon Symbol="Folder24" FontSize="20" Margin="0,0,10,0" Foreground="{StaticResource AccentStrong}" />
                    <StackPanel>
                        <TextBlock Text="{l:Tr backup.group.files}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Tr backup.group.files.hint}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding FileItems}" ItemTemplate="{StaticResource ItemCard}" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Destino -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Command="{Binding ChangeDestinationCommand}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderSwap20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr common.change}" /></StackPanel>
                            </Button>
                            <Border Style="{StaticResource IconBubble}">
                                <ui:SymbolIcon Symbol="Save24" FontSize="20" Foreground="{StaticResource AccentStrong}" />
                            </Border>
                            <StackPanel Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:Tr backup.destination}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding Destination}" Style="{StaticResource CaptionTrim}" />
                            </StackPanel>
                        </DockPanel>
                        <CheckBox IsChecked="{Binding IncludeConfig}" Content="{l:Tr backup.include-config}" Margin="0,14,0,0" />
                        <TextBlock Text="{l:Tr backup.layout}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra de acción -->
        <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="36,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" FontWeight="SemiBold"
                               Visibility="{Binding IsRunning, Converter={StaticResource InvBoolToVis}}" />
                    <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PhaseText}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding Percent}" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding CurrentFile}" Style="{StaticResource CaptionTrim}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SoftButton}" Command="{Binding CancelCommand}" Margin="0,0,10,0" Content="{l:Tr common.cancel}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource GradientButton}" Command="{Binding StartCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Archive20" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Tr backup.start}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
