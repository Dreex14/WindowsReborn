<UserControl x:Class="WindowsReborn.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure"
             xmlns:vm="clr-namespace:WindowsReborn.App.ViewModels">
    <Grid Margin="28,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Cabecera con perfiles -->
        <Grid Grid.ColumnSpan="2" Margin="0,0,28,12" IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr backup.title}" />
                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.subtitle}" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Width="220" VerticalAlignment="Center"
                      ToolTip="{l:Tr profile.tooltip}" />
            <ui:Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="{l:Tr profile.save}" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveProfileCommand}" Margin="8,0,0,0" />
            <ui:Button Grid.Column="3" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteProfileCommand}" ToolTip="{l:Tr profile.delete}" />
        </Grid>

        <!-- Qué copiar -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,16,24" IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr backup.recommended}" />
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryItem}">
                            <Border Style="{StaticResource Row}" Margin="0,0,6,6" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Available}" VerticalAlignment="Center" MinWidth="0" />
                                    <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Symbol}" FontSize="18" Margin="2,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource CaptionTrim}" Text="{Binding DisplayPath}" ToolTip="{Binding DisplayPath}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SizeText}" Visibility="{Binding SizeText, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Carpetas personalizadas -->
                <Grid Margin="0,14,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr backup.custom-folders}" VerticalAlignment="Center" Margin="0" />
                    <ui:Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="{l:Tr backup.add-folder}" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddFolderCommand}" />
                    <ui:Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="{l:Tr backup.add-projects}" Icon="{ui:SymbolIcon Code24}" Command="{Binding AddProjectsFolderCommand}" ToolTip="{l:Tr backup.is-projects-tip}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding CustomPathText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr backup.path-placeholder}" Icon="{ui:SymbolIcon TextEditStyle24}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddTypedPathCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="{l:Tr backup.add-path}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddTypedPathCommand}" />
                </Grid>
                <Border Style="{StaticResource Row}" Visibility="{Binding CustomFolders.Count, Converter={x:Static l:CountToVisibility.WhenEmpty}}" Padding="14,14">
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.custom-empty}" />
                </Border>
                <ItemsControl ItemsSource="{Binding CustomFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CustomFolderItem}">
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" IsEnabled="{Binding Exists}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource CaptionTrim}" Text="{Binding DisplayPath}" ToolTip="{Binding DisplayPath}" />
                                        <TextBlock x:Name="Status" Style="{StaticResource Caption}" Text="{Binding StatusText}" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Content="{l:Tr backup.is-projects}" IsChecked="{Binding IsProjects}" ToolTip="{l:Tr backup.is-projects-tip}" Margin="0,0,4,0" />
                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:Tr common.remove}"
                                                   Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <ui:TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,6,0,0" Text="{Binding ExclusionsText, UpdateSourceTrigger=LostFocus}"
                                                PlaceholderText="{l:Tr backup.folder-exclusions}" FontSize="12" ToolTip="{l:Tr backup.folder-exclusions-help}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Configuración de aplicaciones -->
                <Expander Margin="0,10,0,0" Header="{l:Tr backup.app-configs}">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.app-configs-help}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Adapters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AdapterItem}">
                                    <Border Style="{StaticResource Row}" Margin="0,0,6,6" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Present}" VerticalAlignment="Center" MinWidth="0" />
                                            <StackPanel Grid.Column="1" Margin="2,0,0,0">
                                                <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource CaptionTrim}" Text="{Binding Files}" ToolTip="{Binding Files}" />
                                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.adapter-missing}" Visibility="{Binding Present, Converter={StaticResource InvBoolToVis}}" />
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Warning}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                           Visibility="{Binding Warning, Converter={StaticResource NullToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{l:Tr backup.config-always-detail}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Dónde, cómo y crear -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <DockPanel>
                <!-- Acciones fijas -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                        <!-- Resumen -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr backup.step3}" Margin="0,0,0,4" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,4">
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.sum-files}" />
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SummaryFiles}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,4">
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.sum-size}" />
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SummarySize}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,4">
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.sum-required}" />
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SummaryRequired}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,4">
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.sum-free}" />
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SummaryFree}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </UniformGrid>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                        <ItemsControl ItemsSource="{Binding Errors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Error" Title="{Binding}" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="{Binding}" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Visibility="{Binding ResultVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <ui:InfoBar IsOpen="{Binding ResultVisible}" IsClosable="False" Severity="{Binding ResultSeverity}" Title="{Binding ResultTitle}" Message="{Binding ResultMessage}" />
                            <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:Tr backup.open-location}"
                                       Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenResultCommand}" Visibility="{Binding ResultPath, Converter={StaticResource NullToVis}}" />
                            <Expander Header="{l:Tr backup.skipped-list}" Margin="0,8,0,0" Visibility="{Binding SkippedItems.Count, Converter={x:Static l:CountToVisibility.Instance}}">
                                <ListBox ItemsSource="{Binding SkippedItems}" MaxHeight="160" FontSize="12" />
                            </Expander>
                        </StackPanel>
                    <Border Style="{StaticResource Row}" Margin="0,0,0,8">
                        <Border.Visibility>
                            <MultiBinding Converter="{x:Static l:VisibilityAny.Instance}">
                                <Binding Path="IsBusy" />
                                <Binding Path="IsRunning" />
                            </MultiBinding>
                        </Border.Visibility>
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding PhaseText}" />
                                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" Text="{Binding ProgressValue, StringFormat={}{0:0}%}"
                                           Visibility="{Binding ProgressIndeterminate, Converter={StaticResource InvBoolToVis}}" />
                            </Grid>
                            <ProgressBar Margin="0,8" Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}" />
                            <TextBlock Style="{StaticResource CaptionTrim}" Text="{Binding CurrentItem}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding ProgressDetail}" />
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Content="{l:Tr backup.analyze}" Icon="{ui:SymbolIcon Search24}" Command="{Binding AnalyzeCommand}" />
                        <ui:Button Grid.Column="2" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Content="{l:Tr backup.create}" Icon="{ui:SymbolIcon Archive24}" Command="{Binding CreateBackupCommand}" />
                    </Grid>
                    <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Content="{l:Tr common.cancel}" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelCommand}">
                        <ui:Button.Visibility>
                            <MultiBinding Converter="{x:Static l:VisibilityAny.Instance}">
                                <Binding Path="IsBusy" />
                                <Binding Path="IsRunning" />
                            </MultiBinding>
                        </ui:Button.Visibility>
                    </ui:Button>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr backup.analyze-first}" Visibility="{Binding IsAnalyzed, Converter={StaticResource InvBoolToVis}}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14,16,0">
                    <StackPanel>
                        <StackPanel IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr backup.step2}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.destination}" />
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr backup.destination-placeholder}" />
                                <ui:Button Grid.Column="1" Style="{StaticResource IconButton}" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding BrowseDestinationCommand}" ToolTip="{l:Tr common.browse}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.name}" />
                            <ui:TextBox Text="{Binding BackupName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.format}" />
                            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" Margin="0,2,0,8" HorizontalAlignment="Stretch">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <StackPanel Visibility="{Binding IsCompressed, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.compression}" />
                                <ComboBox ItemsSource="{Binding Compressions}" SelectedItem="{Binding SelectedCompression}" Margin="0,2,0,0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8" Visibility="{Binding CanEncrypt, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.password}" />
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
                                    <PasswordBox x:Name="PasswordConfirmInput" Grid.Column="2" PasswordChanged="OnPasswordChanged" />
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.password-help}" Margin="0,4,0,0" />
                                <CheckBox IsChecked="{Binding IncludeSensitive}" Margin="0,4,0,0"><TextBlock TextWrapping="Wrap" Text="{l:Tr backup.include-sensitive}" /></CheckBox>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding IncludeWinGetList}" Margin="0,2"><TextBlock TextWrapping="Wrap" Text="{l:Tr backup.include-winget}" /></CheckBox>
                            <CheckBox IsChecked="{Binding IncludeInstallers}" Margin="0,2">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{l:Tr backup.include-installers}" />
                                    <Run Text="(" /><Run Text="{Binding AvailableInstallers, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding Anonymize}" Margin="0,2"><TextBlock TextWrapping="Wrap" Text="{l:Tr backup.anonymize}" /></CheckBox>
                            <Expander Header="{l:Tr backup.exclusions}" Margin="0,8,0,0">
                                <StackPanel Margin="0,6,0,0">
                                    <ui:TextBox Text="{Binding ExclusionsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                                                MinHeight="90" MaxHeight="160" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr backup.exclusions-help}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
