<UserControl x:Class="WindowsReborn.App.Views.PrepareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure"
             xmlns:vm="clr-namespace:WindowsReborn.App.ViewModels">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <Grid MaxWidth="1100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr prepare.title}" />
                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr prepare.subtitle}" />
            </StackPanel>

            <!-- Comprobaciones -->
            <StackPanel Grid.Row="1" Margin="0,0,16,0">
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr prepare.backup-checked}" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding BackupDisplay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding BackupDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Style="{StaticResource SmallButton}" Content="{l:Tr prepare.choose}" Icon="{ui:SymbolIcon Open24}" Command="{Binding ChooseBackupCommand}" />
                            <ui:Button Style="{StaticResource SmallButton}" Content="{l:Tr prepare.recheck}" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding CheckCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ui:InfoBar IsOpen="True" IsClosable="False" Title="{Binding Summary}" Margin="0,4,0,8">
                    <ui:InfoBar.Style>
                        <Style TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
                            <Setter Property="Severity" Value="Warning" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                    <Setter Property="Severity" Value="Success" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:InfoBar.Style>
                </ui:InfoBar>
                <TextBlock Style="{StaticResource Body}" Text="{Binding Message}" Margin="0,0,0,8" Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />

                <Border Style="{StaticResource Row}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{l:Tr integrity.checking}" />
                            <ui:Button HorizontalAlignment="Right" Style="{StaticResource SmallButton}" Content="{l:Tr common.cancel}" Command="{Binding CancelCommand}" />
                        </Grid>
                        <ProgressBar Margin="0,8" Height="6" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ProgressText}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CheckItem}">
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon x:Name="Icon" Symbol="{Binding Symbol}" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="{Binding ActionLabel}" Command="{Binding Action}" VerticalAlignment="Center"
                                               Visibility="{Binding ActionLabel, Converter={StaticResource NullToVis}}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Ok">
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Warning">
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Error">
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Medio de instalación -->
            <StackPanel Grid.Row="1" Grid.Column="1">
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr prepare.media}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr prepare.media-help}" Margin="0,0,0,12" />
                        <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                                   Content="{l:Tr prepare.windows11}" Icon="{ui:SymbolIcon Globe24}" Command="{Binding OpenWindows11Command}" ToolTip="{x:Static vm:PrepareViewModel.Windows11Url}" />
                        <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                                   Content="{l:Tr prepare.rufus}" Icon="{ui:SymbolIcon UsbStick24}" Command="{Binding OpenRufusCommand}" ToolTip="{x:Static vm:PrepareViewModel.RufusUrl}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr prepare.media-note}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr prepare.after}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr prepare.after-help}" />
                        <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,12,0,0"
                                   Content="{l:Tr prepare.open-folder}" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenBackupFolderCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
