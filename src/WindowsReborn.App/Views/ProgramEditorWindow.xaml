<ui:FluentWindow x:Class="WindowsReborn.App.Views.ProgramEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure"
                 xmlns:vm="clr-namespace:WindowsReborn.App.ViewModels"
                 Title="{Binding WindowTitle}"
                 Width="760" Height="760" MinWidth="640" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False"
                 ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{Binding WindowTitle}" ShowMinimize="False" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Padding="24,4,24,12">
            <StackPanel>
                <!-- Identificación -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr editor.identity}" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr editor.name}" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <ui:Button Grid.Column="2" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Content="{l:Tr editor.identify}" Icon="{ui:SymbolIcon Search24}"
                               Command="{Binding SearchCommand}" IsEnabled="{Binding IsSearching, Converter={StaticResource InvBool}}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Body}" Text="{l:Tr editor.homepage}" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Homepage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://" Margin="0,4" />
                    <ui:Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Content="{l:Tr editor.open}" Icon="{ui:SymbolIcon Globe24}" Command="{Binding OpenHomepageCommand}" />
                </Grid>

                <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,8"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                <StackPanel Visibility="{Binding SearchResults.Count, Converter={x:Static l:CountToVisibility.Instance}}" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr editor.pick-result}" Margin="0,0,0,4" />
                    <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}" MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Id}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding IdentifyNotes}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Fuente -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr editor.source}" Margin="0,8,0,8" />
                <Border Style="{StaticResource Row}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding TrustText}" />
                    </StackPanel>
                </Border>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr editor.source-kind}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SourceKinds}" SelectedItem="{Binding SourceKind}" Margin="0,4" HorizontalAlignment="Left" MinWidth="300" />

                    <TextBlock Grid.Row="1" Style="{StaticResource Body}" Text="{l:Tr editor.winget-id}" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WinGetId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Publisher.App" Margin="0,4" />

                    <TextBlock Grid.Row="2" Style="{StaticResource Body}" Text="{l:Tr editor.repo}" VerticalAlignment="Center" Visibility="{Binding IsGitHub, Converter={StaticResource BoolToVis}}" />
                    <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GitHubRepo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="owner/repo" Margin="0,4"
                                Visibility="{Binding IsGitHub, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="3" Style="{StaticResource Body}" Text="{l:Tr editor.asset}" VerticalAlignment="Center" Visibility="{Binding IsGitHub, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4" Visibility="{Binding IsGitHub, Converter={StaticResource BoolToVis}}">
                        <ui:TextBox Text="{Binding AssetPattern, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="*-x64.msi" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr editor.asset-help}" Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Style="{StaticResource Body}" Text="{l:Tr editor.vendor}" VerticalAlignment="Center" Visibility="{Binding IsVendor, Converter={StaticResource BoolToVis}}" />
                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding VendorAdapterIds}" SelectedItem="{Binding VendorAdapter}" Margin="0,4" HorizontalAlignment="Left" MinWidth="300"
                              Visibility="{Binding IsVendor, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="5" Style="{StaticResource Body}" Text="{l:Tr editor.direct-url}" VerticalAlignment="Center" Visibility="{Binding IsDirectUrl, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,4" Visibility="{Binding IsDirectUrl, Converter={StaticResource BoolToVis}}">
                        <ui:TextBox Text="{Binding DirectUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr editor.direct-url-help}" Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="6" Style="{StaticResource Body}" Text="{l:Tr editor.user-url}" VerticalAlignment="Center" />
                    <Grid Grid.Row="6" Grid.Column="1" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding UserUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr editor.user-url-placeholder}" />
                        <ui:Button Grid.Column="1" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Content="{l:Tr editor.use-url}" Icon="{ui:SymbolIcon Link24}" Command="{Binding UseUserUrlCommand}" />
                    </Grid>
                </Grid>

                <!-- Preferencias -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr editor.preferences}" Margin="0,16,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr editor.arch}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Architectures}" SelectedItem="{Binding Architecture}" Margin="0,4" HorizontalAlignment="Left" MinWidth="200" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Body}" Text="{l:Tr editor.type}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding InstallerTypes}" SelectedItem="{Binding InstallerType}" Margin="0,4" HorizontalAlignment="Left" MinWidth="200" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Body}" Text="{l:Tr editor.mode}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding InstallModes}" SelectedItem="{Binding InstallMode}" Margin="0,4" HorizontalAlignment="Left" MinWidth="300" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Body}" Text="{l:Tr editor.publisher}" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                        <ui:TextBox Text="{Binding ExpectedPublisher, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr editor.publisher-placeholder}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr editor.publisher-help}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="4" Style="{StaticResource Body}" Text="{l:Tr editor.detect}" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DetectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" PlaceholderText="{l:Tr editor.detect-placeholder}" />
                    <TextBlock Grid.Row="5" Style="{StaticResource Body}" Text="{l:Tr editor.notes}" VerticalAlignment="Top" Margin="0,10,0,0" />
                    <ui:TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" Margin="0,4" TextWrapping="Wrap" />
                </Grid>

                <Expander Header="{l:Tr editor.configs}" Margin="0,12,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr editor.configs-help}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ConfigAdapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AdapterChoice}">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Style="{StaticResource Body}" Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" Margin="0,0,280,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Style="{StaticResource ActionButton}" Content="{l:Tr common.cancel}" IsCancel="True" Click="OnCancel" Margin="0,0,8,0" />
                    <ui:Button Style="{StaticResource PrimaryButton}" Content="{l:Tr common.save}" Icon="{ui:SymbolIcon Save24}" IsDefault="True" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
