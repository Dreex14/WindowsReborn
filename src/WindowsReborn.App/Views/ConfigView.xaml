<UserControl x:Class="WindowsReborn.App.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <TextBlock Text="{l:Tr config.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:Tr config.subtitle}" Style="{StaticResource PageSubtitle}" />

            <!-- Importada: aplicar todo -->
            <Border Style="{StaticResource Hero}" Visibility="{Binding HasImported, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource WhiteButton}" Command="{Binding ApplyAllCommand}" VerticalAlignment="Center"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Sparkle20" Foreground="#5B3FD9" Margin="0,0,8,0" Filled="True" />
                            <TextBlock Text="{l:Tr config.apply}" />
                        </StackPanel>
                    </Button>
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="White" FontSize="30" Margin="0,0,16,0" Filled="True" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{l:Tr config.imported.title}" Style="{StaticResource OnHeroTitle}" FontSize="20" />
                        <TextBlock Text="{Binding ImportedText}" Style="{StaticResource OnHeroText}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Exportar / importar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource IconBubble}" HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="ArrowExportUp24" FontSize="20" Foreground="{StaticResource AccentStrong}" />
                        </Border>
                        <TextBlock Text="{l:Tr config.export}" Style="{StaticResource SectionTitle}" Margin="0,12,0,4" />
                        <TextBlock Text="{l:Tr config.export.hint}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,8,0,14" />
                        <Button Style="{StaticResource GradientButton}" Command="{Binding ExportCommand}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save20" Foreground="White" Margin="0,0,8,0" /><TextBlock Text="{l:Tr config.export.button}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource IconBubble}" HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="ArrowImport24" FontSize="20" Foreground="{StaticResource AccentStrong}" />
                        </Border>
                        <TextBlock Text="{l:Tr config.import}" Style="{StaticResource SectionTitle}" Margin="0,12,0,4" />
                        <TextBlock Text="{l:Tr config.import.hint}" Style="{StaticResource Caption}" Margin="0,0,0,14" />
                        <Button Style="{StaticResource SoftButton}" Command="{Binding ImportCommand}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen20" Margin="0,0,8,0" /><TextBlock Text="{l:Tr config.import.button}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,0,0,12" FontSize="13"
                       Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}" />

            <!-- Preferencias de la app -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr settings.title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.language}" Style="{StaticResource Body}" />
                            <TextBlock Text="{l:Tr settings.language.hint}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="200" SelectedIndex="{Binding LanguageIndex}">
                            <ComboBoxItem Content="{l:Tr settings.language.auto}" />
                            <ComboBoxItem Content="Español" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="{l:Tr settings.theme}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" MinWidth="200" SelectedIndex="{Binding ThemeIndex}">
                            <ComboBoxItem Content="{l:Tr settings.theme.dark}" />
                            <ComboBoxItem Content="{l:Tr settings.theme.light}" />
                            <ComboBoxItem Content="{l:Tr settings.theme.system}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Acerca de -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr about.title}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:Tr about.text}" Style="{StaticResource Caption}" Margin="0,6,0,12" />
                    <WrapPanel>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,8" Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/Dreex14/WindowsReborn">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Code20" Margin="0,0,6,0" /><TextBlock Text="GitHub" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,8" Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/hellzerg/optimizer">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Lightbulb20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr about.inspiration}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,8" Command="{Binding OpenDataCommand}">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr about.data}" /></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
