<UserControl x:Class="WindowsReborn.App.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure">
    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate">
            <CheckBox Style="{StaticResource SelectCard}" Margin="0,0,0,8" IsChecked="{Binding IsSelected}"
                      IsEnabled="{Binding IsRemoved, Converter={StaticResource InvBool}}" AutomationProperties.Name="{Binding Title}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:Tr appx.reinstall}" VerticalAlignment="Center"
                            Command="{Binding DataContext.ReinstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Margin="0,0,16,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Border Style="{StaticResource RiskChip}">
                                <TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskChipText}" />
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="{Binding GroupLabel}" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="{StaticResource SafeSoft}" Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{l:Tr appx.state.removed}" Style="{StaticResource ChipText}" Foreground="{StaticResource SafeBrush}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="{StaticResource AdvancedSoft}" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{l:Tr state.failed}" Style="{StaticResource ChipText}" Foreground="{StaticResource AdvancedBrush}" />
                            </Border>
                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Warning}" Style="{StaticResource Caption}" Foreground="{StaticResource ModerateBrush}" Margin="0,4,0,0"
                                   Visibility="{Binding Warning, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </DockPanel>
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                        <Button Style="{StaticResource SoftButton}" Command="{Binding SaveConfigCommand}" Margin="0,0,8,0" ToolTip="{l:Tr section.save.hint}">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr section.save}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Command="{Binding LoadConfigCommand}" ToolTip="{l:Tr section.load.hint}">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr section.load}" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{l:Tr debloat.title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{l:Tr debloat.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,6,24,22" />
                    </StackPanel>
                </DockPanel>

                <!-- Acciones rápidas -->
                <Border Style="{StaticResource Hero}" Padding="24,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="16" Background="#33FFFFFF" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Delete24" Foreground="White" FontSize="28" Filled="True" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr appx.title}" Style="{StaticResource OnHeroTitle}" FontSize="20" />
                            <TextBlock Text="{l:Tr appx.hint}" Style="{StaticResource OnHeroText}" Margin="0,4,0,8" />
                            <CheckBox IsChecked="{Binding PreventReinstall}" Foreground="White">
                                <TextBlock Text="{l:Tr appx.prevent}" Foreground="White" TextWrapping="Wrap" FontSize="12" />
                            </CheckBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource WhiteButton}" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete20" Margin="0,0,8,0" Foreground="#5B3FD9" />
                                    <TextBlock Text="{Binding SelectedCount, Converter={x:Static l:Format.Converter}, ConverterParameter=appx.remove-count}" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                <Button Style="{StaticResource OnHeroButton}" Height="30" FontSize="12" Padding="10,0" Margin="0,0,6,0" Command="{Binding MarkRecommendedCommand}"
                                        Content="{l:Tr appx.mark-recommended}" />
                                <Button Style="{StaticResource OnHeroButton}" Height="30" FontSize="12" Padding="10,0" Command="{Binding UnmarkAllCommand}"
                                        Content="{l:Tr programs.select.none}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" />
                    <TextBlock Text="{l:Tr appx.loading}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                </StackPanel>

                <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource SafeBrush}" FontSize="22" Margin="0,0,12,0" />
                        <TextBlock Text="{l:Tr debloat.empty}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,4,0,10" />
                                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="36,14" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
