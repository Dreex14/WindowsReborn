<UserControl x:Class="WindowsReborn.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure"
             xmlns:vm="clr-namespace:WindowsReborn.App.ViewModels">
    <Grid Margin="28,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,28,12">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr restore.title}" />
            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.subtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pasos del asistente -->
            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,12,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WizardStep}">
                        <Button x:Name="StepButton" Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,7" Margin="0,1" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="24" Height="24" CornerRadius="12" BorderThickness="1" Margin="0,0,10,0"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="Transparent">
                                    <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:SymbolIcon x:Name="StateIcon" Grid.Column="2" Symbol="Checkmark16" FontSize="14" Visibility="Collapsed"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Done">
                                <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Skipped">
                                <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="StateIcon" Property="Symbol" Value="ArrowForward16" />
                                <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Column="1" Margin="0,0,28,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" FontSize="20" Text="{Binding StepTitle}" Margin="0,0,0,10" />

                        <!-- 1. Abrir -->
                        <StackPanel Visibility="{Binding CurrentKey, Converter={x:Static l:EqualsToVisibility.Instance}, ConverterParameter=open}">
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr wizard.open-help}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding BackupDisplayPath, Mode=OneWay}" IsReadOnly="True" PlaceholderText="{l:Tr restore.no-backup}" ToolTip="{Binding BackupDisplayPath}" />
                                <ui:Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{l:Tr restore.open-file}" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenFileCommand}" />
                                <ui:Button Grid.Column="2" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Content="{l:Tr restore.open-folder}" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFolderCommand}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding NeedsPassword, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Body}" Text="{l:Tr restore.password}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <PasswordBox x:Name="PasswordInput" Width="260" PasswordChanged="OnPasswordChanged" />
                                <ui:Button Style="{StaticResource ActionButton}" Margin="8,0,0,0" Content="{l:Tr restore.retry}" Icon="{ui:SymbolIcon LockClosed24}" Command="{Binding RetryWithPasswordCommand}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Messages}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="{Binding}" Margin="0,4,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Section}" Margin="0,12,0,0" Visibility="{Binding IsOpen, Converter={StaticResource InvBoolToVis}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr wizard.no-backup-title}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr wizard.no-backup-help}" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Style="{StaticResource ActionButton}" Content="{l:Tr wizard.open-last}" Icon="{ui:SymbolIcon History24}" Command="{Binding OpenLastBackupCommand}" Margin="0,0,8,0"
                                                   Visibility="{Binding HasLastBackup, Converter={StaticResource BoolToVis}}" />
                                        <ui:Button Style="{StaticResource ActionButton}" Content="{l:Tr wizard.import-config}" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportConfigOnlyCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Section}" Margin="0,12,0,0" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,10">
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.created}" />
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding CreatedText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,10">
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.machine}" />
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding MachineText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,10">
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.windows}" />
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding WindowsText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.size}" />
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding SizeText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.format}" />
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding FormatText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.config-short}" />
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding ConfigStatus}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <!-- 2. Verificar -->
                        <StackPanel Visibility="{Binding CurrentKey, Converter={x:Static l:EqualsToVisibility.Instance}, ConverterParameter=verify}">
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr wizard.verify-help}" Margin="0,0,0,10" />
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.integrity}" />
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding IntegrityText}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{l:Tr restore.verify}" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding VerifyCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 3. Contenido y destinos -->
                        <StackPanel Visibility="{Binding CurrentKey, Converter={x:Static l:EqualsToVisibility.Instance}, ConverterParameter=select}">
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.targets-help}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Categories}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RestoreCategoryItem}">
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="2*" MinWidth="180" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" />
                                                <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" />
                                                    <TextBlock Style="{StaticResource CaptionTrim}" Text="{Binding Origin}" ToolTip="{Binding Origin}" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding AppNote}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                               Visibility="{Binding AppNote, Converter={StaticResource NullToVis}}" />
                                                </StackPanel>
                                                <ui:TextBox Grid.Column="2" Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr restore.target-placeholder}" VerticalAlignment="Center" />
                                                <ui:Button Grid.Column="3" Style="{StaticResource SmallButton}" Content="{l:Tr common.browse}"
                                                           Command="{Binding DataContext.BrowseTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr restore.conflicts}" Margin="0,12,0,4" />
                            <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                                <RadioButton GroupName="Policy" Content="{l:Tr restore.policy-skip}" Margin="0,2"
                                             IsChecked="{Binding Policy, Converter={StaticResource EnumEquals}, ConverterParameter=Skip}" />
                                <RadioButton GroupName="Policy" Content="{l:Tr restore.policy-rename}" Margin="0,2"
                                             IsChecked="{Binding Policy, Converter={StaticResource EnumEquals}, ConverterParameter=Rename}" />
                                <RadioButton GroupName="Policy" Content="{l:Tr restore.policy-overwrite}" Margin="0,2"
                                             IsChecked="{Binding Policy, Converter={StaticResource EnumEquals}, ConverterParameter=Overwrite}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 4. Recuperar archivos -->
                        <StackPanel Visibility="{Binding CurrentKey, Converter={x:Static l:EqualsToVisibility.Instance}, ConverterParameter=files}">
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr wizard.files-help}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding PlanText}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button Style="{StaticResource ActionButton}" Content="{l:Tr restore.analyze}" Icon="{ui:SymbolIcon Search24}" Command="{Binding AnalyzeCommand}" Margin="8,0,8,0" />
                                        <ui:Button Style="{StaticResource PrimaryButton}" Content="{l:Tr restore.restore}" Icon="{ui:SymbolIcon History24}" Command="{Binding RestoreCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding ResultVisible, Converter={StaticResource BoolToVis}}">
                                <ui:InfoBar IsOpen="{Binding ResultVisible}" IsClosable="False" Severity="{Binding ResultSeverity}" Title="{Binding ResultTitle}" Message="{Binding ResultMessage}" />
                                <Expander Header="{l:Tr restore.report-details}" Margin="0,8,0,0" Visibility="{Binding ReportLines.Count, Converter={x:Static l:CountToVisibility.Instance}}">
                                    <ListBox ItemsSource="{Binding ReportLines}" MaxHeight="240" FontSize="12" />
                                </Expander>
                            </StackPanel>
                        </StackPanel>

                        <!-- 5. Configuración de Windows Reborn -->
                        <StackPanel Visibility="{Binding CurrentKey, Converter={x:Static l:EqualsToVisibility.Instance}, ConverterParameter=config}">
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.config-what}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding ConfigStatus}" VerticalAlignment="Center" />
                                    <ui:Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{l:Tr restore.config-recover}" Icon="{ui:SymbolIcon ArrowImport24}"
                                               Command="{Binding RecoverConfigurationCommand}" Visibility="{Binding HasConfiguration, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 6. Programas -->
                        <StackPanel Visibility="{Binding CurrentKey, Converter={x:Static l:EqualsToVisibility.Instance}, ConverterParameter=programs}">
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.programs-what}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding ProgramsSummary}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.installers-included}" Visibility="{Binding HasInstallers, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.winget-included}" Visibility="{Binding HasWinGetList, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr restore.programs-disclaimer}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{l:Tr restore.go-programs}" Icon="{ui:SymbolIcon Apps24}" Command="{Binding GoToProgramsCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 7. Ajustes de Windows -->
                        <StackPanel Visibility="{Binding CurrentKey, Converter={x:Static l:EqualsToVisibility.Instance}, ConverterParameter=settings}">
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr wizard.settings-help}" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding PreferencesStatus}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Preferences}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PreferenceItem}">
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSupported}" MinWidth="0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                                    <WrapPanel>
                                                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" Margin="0,0,10,0" />
                                                        <Border Style="{StaticResource RiskBadge}">
                                                            <TextBlock FontSize="11" Text="{Binding RiskLabel}" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding StateText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Style="{StaticResource Body}" Text="{Binding OptionLabel}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Button Style="{StaticResource PrimaryButton}" Content="{l:Tr wizard.apply-prefs}" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyPreferencesCommand}" Margin="0,0,12,0" />
                                <CheckBox Content="{l:Tr tweak.create-restore-point}" IsChecked="{Binding CreateRestorePoint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ui:Button Style="{StaticResource ActionButton}" Content="{l:Tr wizard.open-personalization}" Icon="{ui:SymbolIcon PaintBrush24}" Command="{Binding OpenPersonalizationCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 8. Informe -->
                        <StackPanel Visibility="{Binding CurrentKey, Converter={x:Static l:EqualsToVisibility.Instance}, ConverterParameter=report}">
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr wizard.report-help}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource Section}">
                                <ItemsControl ItemsSource="{Binding FinalReport}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Body}" Text="{Binding}" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Style="{StaticResource PrimaryButton}" Content="{l:Tr wizard.save-report}" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveFinalReportCommand}" Margin="0,0,8,0" />
                                <ui:Button Style="{StaticResource ActionButton}" Content="{l:Tr restore.open-reports}" Icon="{ui:SymbolIcon DocumentBulletList24}" Command="{Binding OpenReportsCommand}" Margin="0,0,8,0" />
                                <ui:Button Style="{StaticResource ActionButton}" Content="{l:Tr restore.tool-system-restore}" Icon="{ui:SymbolIcon History24}" Command="{Binding OpenSystemRestoreCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Progreso -->
                <Border Grid.Row="1" Style="{StaticResource Row}" Margin="0,8,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding PhaseText}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding ProgressValue, StringFormat={}{0:0}%}" Margin="0,0,8,0" />
                                <ui:Button Style="{StaticResource SmallButton}" Content="{l:Tr common.cancel}" Command="{Binding CancelCommand}" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Margin="0,8" Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionTrim}" Text="{Binding CurrentItem}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ProgressDetail}" />
                    </StackPanel>
                </Border>

                <!-- Navegación del asistente -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <ui:Button Style="{StaticResource ActionButton}" Content="{l:Tr wizard.back}" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Style="{StaticResource ActionButton}" Content="{l:Tr wizard.skip}" Command="{Binding SkipCommand}" Margin="0,0,8,0" ToolTip="{l:Tr wizard.skip-help}" />
                        <ui:Button Style="{StaticResource PrimaryButton}" Content="{l:Tr wizard.next}" Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding NextCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
