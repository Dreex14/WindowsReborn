<UserControl x:Class="WindowsReborn.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure"
             xmlns:vm="clr-namespace:WindowsReborn.App.ViewModels">
    <Grid Margin="28,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera: título, búsqueda y filtro de riesgo -->
        <Grid Margin="0,0,28,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
            </StackPanel>
            <ui:TextBox Grid.Column="1" Width="260" Margin="16,0,8,0" VerticalAlignment="Center"
                        PlaceholderText="{l:Tr tweak.search}" Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" ClearButtonEnabled="True" />
            <ComboBox Grid.Column="2" Width="170" VerticalAlignment="Center" ItemsSource="{Binding RiskFilters}" SelectedItem="{Binding SelectedRisk}"
                      ToolTip="{l:Tr risk.filter}" />
        </Grid>

        <!-- Avisos: resultado de la última operación y reinicio pendiente -->
        <StackPanel Grid.Row="1" Margin="0,0,28,0">
            <ui:InfoBar IsOpen="{Binding StatusVisible, Mode=TwoWay}" IsClosable="True" Severity="{Binding StatusSeverity}" Title="{Binding StatusTitle}" Message="{Binding StatusMessage}" Margin="0,0,0,8" />
            <Border Style="{StaticResource Row}" Visibility="{Binding HasPendingRestart, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,10,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding PendingRestartText}" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="{l:Tr restart.explorer-button}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Command="{Binding RestartExplorerCommand}" Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Categorías y acciones -->
            <DockPanel Margin="0,0,12,16" LastChildFill="False">
                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryFilter}">
                            <StackPanel Orientation="Horizontal" Margin="2,0">
                                <ui:SymbolIcon Symbol="{Binding Symbol}" Margin="0,0,10,0" FontSize="16" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel DockPanel.Dock="Bottom">
                    <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6" Content="{l:Tr tweak.recommended}" Icon="{ui:SymbolIcon CheckmarkStarburst24}"
                               Command="{Binding ApplyRecommendedCommand}" Visibility="{Binding IsPrivacy, Converter={StaticResource BoolToVis}}" ToolTip="{l:Tr tweak.recommended-help}" />
                    <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6" Command="{Binding RevertAllCommand}" Icon="{ui:SymbolIcon ArrowUndo24}"
                               Content="{Binding ChangedCount, Converter={x:Static l:Format.Converter}, ConverterParameter=tweak.revert-all-count}" ToolTip="{l:Tr tweak.revert-all-help}" />
                    <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6" Content="{l:Tr tweak.refresh}" Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding RefreshAllCommand}" ToolTip="{l:Tr tweak.refresh-help}" />
                    <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10" Content="{l:Tr tweak.system-protection}" Icon="{ui:SymbolIcon History24}"
                               Command="{Binding OpenSystemProtectionCommand}" ToolTip="{l:Tr tweak.system-protection-help}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding WindowsText}" />
                </StackPanel>
            </DockPanel>

            <!-- Lista de ajustes -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,28,24" Visibility="{Binding IsTweakList, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="{Binding VisibleCount, Converter={x:Static l:Format.Converter}, ConverterParameter=tweak.visible-count}" />
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr tweak.no-results}" Margin="0,24" HorizontalAlignment="Center"
                               Visibility="{Binding VisibleCount, Converter={x:Static l:CountToVisibility.WhenEmpty}}" />
                    <ItemsControl ItemsSource="{Binding View}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Name}" Margin="2,10,0,6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TweakItem}">
                                <Border Style="{StaticResource Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <WrapPanel>
                                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" Margin="0,0,10,2" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource RiskBadge}">
                                                    <TextBlock FontSize="11" Text="{Binding RiskLabel}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}" ToolTip="{l:Tr tweak.admin-help}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Shield24" FontSize="11" Margin="0,0,4,0" />
                                                        <TextBlock FontSize="11" Text="{l:Tr tweak.admin}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Visibility="{Binding RestartLabel, Converter={StaticResource NullToVis}}">
                                                    <TextBlock FontSize="11" Text="{Binding RestartLabel}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" Margin="0,2,0,0" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Warning}" Margin="0,3,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Visibility="{Binding Warning, Converter={StaticResource NullToVis}}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SupportText}" Margin="0,3,0,0" FontStyle="Italic"
                                                       Visibility="{Binding SupportText, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding RevertCommand}" Margin="0,0,8,0"
                                                       ToolTip="{l:Tr tweak.revert-help}" Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsEnabled}" />
                                            <ui:ToggleSwitch IsChecked="{Binding IsOn}" IsEnabled="{Binding IsEnabled}" MinWidth="0"
                                                             Visibility="{Binding IsToggle, Converter={StaticResource BoolToVis}}" />
                                            <ComboBox Width="170" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsEnabled="{Binding IsEnabled}"
                                                      Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                            <ui:Button Style="{StaticResource SmallButton}" Content="{l:Tr tweak.open-official}" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenCommand}"
                                                       Visibility="{Binding IsInfo, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Aplicaciones de inicio -->
            <Grid Grid.Column="1" Margin="0,0,28,16" Visibility="{Binding IsStartupList, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr startup.help}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Style="{StaticResource SmallButton}" Content="{l:Tr tweak.refresh}" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadStartupCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Content="{l:Tr startup.open-settings}" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenStartupSettingsCommand}" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Style="{StaticResource Body}" Text="{l:Tr startup.empty}" HorizontalAlignment="Center" Margin="0,24"
                           Visibility="{Binding StartupItems.Count, Converter={x:Static l:CountToVisibility.WhenEmpty}}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding StartupItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StartupItem}">
                                <Border Style="{StaticResource Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <WrapPanel>
                                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" Margin="0,0,10,2" />
                                                <Border Style="{StaticResource Badge}">
                                                    <TextBlock FontSize="11" Text="{Binding LocationLabel}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock FontSize="11" Text="{l:Tr tweak.admin}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource CaptionTrim}" Text="{Binding Command}" ToolTip="{Binding Command}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                            <ui:ToggleSwitch IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}" MinWidth="0" ToolTipService.ShowOnDisabled="True" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Aplicaciones preinstaladas -->
            <Grid Grid.Column="1" Margin="0,0,28,16" Visibility="{Binding IsAppxList, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr appx.help}" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="{l:Tr tweak.refresh}" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadAppxCommand}" />
                </Grid>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,32" Visibility="{Binding AppxLoading, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing IsIndeterminate="True" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr appx.loading}" Margin="0,8,0,0" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding AppxLoading, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{l:Tr appx.empty}" HorizontalAlignment="Center" Margin="0,24"
                                   Visibility="{Binding AppxItems.Count, Converter={x:Static l:CountToVisibility.WhenEmpty}}" />
                        <ItemsControl ItemsSource="{Binding AppxItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AppxItem}">
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <WrapPanel>
                                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" Margin="0,0,10,2" />
                                                    <Border Style="{StaticResource RiskBadge}">
                                                        <TextBlock FontSize="11" Text="{Binding RiskLabel}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock FontSize="11" Text="{l:Tr appx.removed-badge}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding PackageName}" />
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Warning}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                           Visibility="{Binding Warning, Converter={StaticResource NullToVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                                <ui:Button Style="{StaticResource SmallButton}" Content="{l:Tr appx.remove}" Icon="{ui:SymbolIcon Delete24}"
                                                           Command="{Binding DataContext.RemoveAppxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                           IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                                                           Visibility="{Binding IsRemoved, Converter={StaticResource InvBoolToVis}}" />
                                                <ui:Button Style="{StaticResource SmallButton}" Content="{l:Tr appx.reinstall}" Icon="{ui:SymbolIcon ArrowDownload24}"
                                                           Command="{Binding DataContext.ReinstallAppxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                           Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
