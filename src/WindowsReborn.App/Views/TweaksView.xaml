<UserControl x:Class="WindowsReborn.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure">
    <UserControl.Resources>
        <!-- Pestañas de categoría (ListBox con aspecto de píldora) -->
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="16" Padding="14,6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock x:Name="Tx" Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGradient}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Tx" Property="Foreground" Value="White" />
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filtro de riesgo -->
        <Style x:Key="RiskFilter" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" CornerRadius="16" Padding="12,5" BorderThickness="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" Opacity="0.45">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{TemplateBinding Foreground}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PendingBorder" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentStrong}" />
                    <Setter Property="Background" Value="#1A7C5CFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

                <!-- Configuración recomendada -->
                <Border x:Name="PresetHero" Style="{StaticResource Hero}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="16" Background="#33FFFFFF" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="PresetIcon" Symbol="ShieldCheckmark24" Foreground="White" FontSize="28" Filled="True" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PresetTitle}" Style="{StaticResource OnHeroTitle}" FontSize="20" />
                            <TextBlock Text="{Binding PresetText}" Style="{StaticResource OnHeroText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource WhiteButton}" Command="{Binding ApplyPresetCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Sparkle20" Margin="0,0,8,0" Foreground="#5B3FD9" Filled="True" />
                                    <TextBlock Text="{l:Tr tweaks.preset.apply}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OnHeroButton}" Command="{Binding MarkPresetCommand}" Margin="0,8,0,0" Height="32" FontSize="12"
                                    Content="{l:Tr tweaks.preset.mark}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filtros -->
                <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" ItemContainerStyle="{StaticResource TabItemStyle}"
                         Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>

                <Grid Margin="0,6,0,14" Visibility="{Binding IsTweakList, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource RiskFilter}" IsChecked="{Binding ShowSafe}" Content="{l:Tr risk.1}"
                                  Foreground="{StaticResource SafeBrush}" Background="{StaticResource SafeSoft}" BorderBrush="{StaticResource SafeBrush}" />
                        <CheckBox Style="{StaticResource RiskFilter}" IsChecked="{Binding ShowModerate}" Content="{l:Tr risk.2}"
                                  Foreground="{StaticResource ModerateBrush}" Background="{StaticResource ModerateSoft}" BorderBrush="{StaticResource ModerateBrush}" />
                        <CheckBox Style="{StaticResource RiskFilter}" IsChecked="{Binding ShowAdvanced}" Content="{l:Tr risk.3}"
                                  Foreground="{StaticResource AdvancedBrush}" Background="{StaticResource AdvancedSoft}" BorderBrush="{StaticResource AdvancedBrush}" />
                    </StackPanel>
                    <ui:TextBox Grid.Column="1" Margin="16,0,0,0" MaxWidth="340" HorizontalAlignment="Right" Width="340"
                                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr common.search}">
                        <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search20" /></ui:TextBox.Icon>
                    </ui:TextBox>
                </Grid>

                <!-- Lista de ajustes -->
                <ItemsControl ItemsSource="{Binding View}" Visibility="{Binding IsTweakList, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PendingBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,4"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource RiskChip}" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskChipText}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Margin="0,0,6,4" Visibility="{Binding InPreset, Converter={StaticResource BoolToVis}}"
                                                    Background="{StaticResource AccentSoft}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Star12" FontSize="10" Foreground="{StaticResource AccentStrong}" Margin="0,0,4,0" Filled="True" />
                                                    <TextBlock Text="{l:Tr tweaks.tag.recommended}" Style="{StaticResource ChipText}" Foreground="{StaticResource AccentStrong}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Margin="0,0,6,4" Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="ShieldKeyhole16" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBlock Text="{l:Tr tweaks.tag.admin}" Style="{StaticResource ChipText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Margin="0,0,6,4" Visibility="{Binding RestartLabel, Converter={StaticResource NullToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="ArrowSync16" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding RestartLabel}" Style="{StaticResource ChipText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Margin="0,0,6,4" Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}"
                                                    Background="{StaticResource InfoSoft}">
                                                <TextBlock Text="{l:Tr tweaks.tag.pending}" Style="{StaticResource ChipText}" Foreground="{StaticResource InfoBrush}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="13" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding Warning, Converter={StaticResource NullToVis}}">
                                            <ui:SymbolIcon Symbol="Warning16" FontSize="13" Foreground="{StaticResource ModerateBrush}" Margin="0,1,6,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Warning}" Style="{StaticResource Caption}" Foreground="{StaticResource ModerateBrush}" MaxWidth="640" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Command="{Binding RevertCommand}" ToolTip="{l:Tr tweaks.revert}" Margin="0,0,6,0"
                                                Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon Symbol="ArrowUndo20" />
                                        </Button>
                                        <ui:ToggleSwitch IsChecked="{Binding IsOn}" Visibility="{Binding IsToggle, Converter={StaticResource BoolToVis}}"
                                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                                                         AutomationProperties.Name="{Binding Title}" />
                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" MinWidth="150"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding Title}" />
                                        <Button Style="{StaticResource SoftButton}" Command="{Binding OpenCommand}" Content="{l:Tr common.open}"
                                                Visibility="{Binding IsInfo, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Inicio de Windows -->
                <StackPanel Visibility="{Binding IsStartupList, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                    <TextBlock Text="{l:Tr startup.hint}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding StartupRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center"
                                                         AutomationProperties.Name="{Binding Name}" />
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Command}" Style="{StaticResource CaptionTrim}" ToolTip="{Binding Command}" />
                                            <TextBlock Text="{Binding LocationLabel}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Apps preinstaladas -->
                <StackPanel Visibility="{Binding IsAppxList, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                    <TextBlock Text="{l:Tr appx.hint}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding AppxLoading, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" />
                        <TextBlock Text="{l:Tr appx.loading}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding AppxRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SoftButton}" Content="{l:Tr appx.remove}"
                                                    Command="{Binding DataContext.RemoveAppxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Visibility="{Binding IsRemoved, Converter={StaticResource InvBoolToVis}}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                                            <Button Style="{StaticResource GhostButton}" Content="{l:Tr appx.reinstall}"
                                                    Command="{Binding DataContext.ReinstallAppxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Border Style="{StaticResource RiskChip}">
                                                    <TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskChipText}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Warning}" Style="{StaticResource Caption}" Foreground="{StaticResource ModerateBrush}" Margin="0,4,0,0"
                                                       Visibility="{Binding Warning, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra de acción -->
        <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="36,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                               Text="{Binding ChangedCount, Converter={x:Static l:Format.Converter}, ConverterParameter=tweaks.pending-count}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}" />
                    <CheckBox IsChecked="{Binding CreateRestorePoint}" Content="{l:Tr tweaks.restore-point}" Margin="0,4,0,0" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SoftButton}" Command="{Binding RestartExplorerCommand}" Margin="0,0,10,0"
                            Visibility="{Binding ExplorerRestartNeeded, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSync20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr tweaks.restart-explorer}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding RevertAllCommand}" Margin="0,0,6,0" Height="38">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowUndo20" Margin="0,0,6,0" /><TextBlock Text="{l:Tr tweaks.revert-all}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SoftButton}" Command="{Binding DiscardCommand}" Margin="0,0,10,0" Content="{l:Tr tweaks.discard}" />
                    <Button Style="{StaticResource GradientButton}" Command="{Binding ApplyCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark20" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Tr tweaks.apply}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
