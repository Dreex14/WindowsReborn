<UserControl x:Class="WindowsReborn.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScroll}">
        <Grid MaxWidth="1100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr home.title}" />
                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr home.subtitle}" />
            </StackPanel>

            <!-- Primer uso: recuperar configuración -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                <ui:InfoBar IsOpen="{Binding IsFirstRun}" IsClosable="False" Severity="Informational" Title="{l:Tr home.first-run}" Message="{l:Tr home.first-run-detail}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <ui:Button Style="{StaticResource PrimaryButton}" Content="{l:Tr home.import-backup}" Icon="{ui:SymbolIcon Open24}" Command="{Binding ImportBackupCommand}" Margin="0,0,8,0" />
                    <ui:Button Style="{StaticResource ActionButton}" Content="{l:Tr home.import-config}" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportConfigCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Acciones principales -->
            <StackPanel Grid.Row="2">
                <TextBlock Style="{StaticResource Body}" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource NullToVis}}" Margin="0,0,0,10" />
                <UniformGrid Columns="3">
                    <ui:Button Style="{StaticResource Tile}" Command="{Binding NavigateCommand}" CommandParameter="backup">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Archive24" FontSize="24" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{l:Tr nav.backup}" Margin="0,8,0,2" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr home.backup-desc}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource Tile}" Command="{Binding NavigateCommand}" CommandParameter="prepare">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="24" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{l:Tr nav.prepare}" Margin="0,8,0,2" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr home.prepare-desc}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource Tile}" Command="{Binding NavigateCommand}" CommandParameter="restore">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="History24" FontSize="24" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{l:Tr nav.restore}" Margin="0,8,0,2" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr home.restore-desc}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource Tile}" Command="{Binding NavigateCommand}" CommandParameter="programs">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Apps24" FontSize="24" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{l:Tr nav.programs}" Margin="0,8,0,2" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr home.programs-desc}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource Tile}" Command="{Binding NavigateCommand}" CommandParameter="personalization">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="PaintBrush24" FontSize="24" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{l:Tr nav.personalization}" Margin="0,8,0,2" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr home.personalization-desc}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource Tile}" Command="{Binding NavigateCommand}" CommandParameter="privacy">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="24" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{l:Tr nav.privacy}" Margin="0,8,0,2" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr home.privacy-desc}" />
                        </StackPanel>
                    </ui:Button>
                </UniformGrid>
            </StackPanel>

            <!-- Estado -->
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,0">
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr home.status}" />
                            <ui:Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" ToolTip="{l:Tr tweak.refresh}" Margin="0,-6,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding LastBackupText}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding LastBackupDetail}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding ProgramsText}" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding TweaksText}" Margin="0,2,0,8" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding WindowsText}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding VersionText}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr home.portable}" Visibility="{Binding IsPortable, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr prepare.media}" />
                        <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                   Content="{l:Tr prepare.windows11}" Icon="{ui:SymbolIcon Globe24}" Command="{Binding OpenWindows11Command}" />
                        <ui:Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Content="{l:Tr prepare.rufus}" Icon="{ui:SymbolIcon UsbStick24}" Command="{Binding OpenRufusCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
