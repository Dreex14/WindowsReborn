<UserControl x:Class="WindowsReborn.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure">
    <UserControl.Resources>
        <!-- Paso clicable -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="14,12" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="StepTemplate">
            <Button Style="{StaticResource StepButton}" Command="{Binding DataContext.GoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Target}" AutomationProperties.Name="{Binding Title}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44">
                        <Border CornerRadius="13" Background="{StaticResource AccentSoft}" />
                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Foreground="{StaticResource AccentStrong}" />
                        <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource AccentGradient}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                            <TextBlock Text="{Binding Number}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <!-- Portada -->
            <Border Style="{StaticResource Hero}" Padding="34,30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <Border Background="#33FFFFFF" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="{l:Tr home.badge}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{l:Tr home.title}" Style="{StaticResource OnHeroTitle}" FontSize="32" />
                        <TextBlock Text="{l:Tr home.subtitle}" Style="{StaticResource OnHeroText}" Margin="0,10,0,20" FontSize="15" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource WhiteButton}" Command="{Binding GoCommand}" CommandParameter="backup" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Archive20" Foreground="#5B3FD9" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:Tr home.cta.backup}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OnHeroButton}" Command="{Binding GoCommand}" CommandParameter="restore" Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowImport20" Foreground="White" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:Tr home.cta.restore}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="150" Height="150" VerticalAlignment="Center" Margin="20,0,10,0">
                        <Ellipse Fill="#22FFFFFF" />
                        <Ellipse Fill="#22FFFFFF" Margin="22" />
                        <ui:SymbolIcon Symbol="ArrowSync24" Foreground="White" FontSize="64" Filled="True" />
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,12" Visibility="{Binding LastBackup, Converter={StaticResource NullToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding OpenLastBackupCommand}" Content="{l:Tr common.open-folder}" />
                    <ui:SymbolIcon Symbol="CheckmarkCircle20" Foreground="{StaticResource SafeBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding LastBackup}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Pasos -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="14,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,10">
                            <ui:SymbolIcon Symbol="Clock20" Foreground="{StaticResource AccentStrong}" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Tr home.before}" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Before}" ItemTemplate="{StaticResource StepTemplate}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,10">
                            <ui:SymbolIcon Symbol="Sparkle20" Foreground="{StaticResource AccentStrong}" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Tr home.after}" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding After}" ItemTemplate="{StaticResource StepTemplate}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- USB de instalación -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource IconBubble}" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="UsbStick24" FontSize="20" Foreground="{StaticResource AccentStrong}" />
                    </Border>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="{l:Tr home.usb.title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Tr home.usb.text}" Style="{StaticResource Caption}" Margin="0,4,0,14" />
                        <WrapPanel>
                            <Button Style="{StaticResource GradientButton}" Margin="0,0,10,8" Command="{Binding OpenLinkCommand}" CommandParameter="https://www.microsoft.com/software-download/windows11">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowDownload20" Foreground="White" Margin="0,0,8,0" /><TextBlock Text="{l:Tr home.usb.iso11}" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SoftButton}" Height="40" Margin="0,0,10,8" Command="{Binding OpenLinkCommand}" CommandParameter="https://rufus.ie/">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="UsbStick20" Margin="0,0,8,0" /><TextBlock Text="{l:Tr home.usb.rufus}" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Height="40" Margin="0,0,10,8" Command="{Binding OpenLinkCommand}" CommandParameter="https://www.microsoft.com/software-download/windows10">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Open20" Margin="0,0,8,0" /><TextBlock Text="{l:Tr home.usb.iso10}" /></StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{l:Tr home.usb.steps}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
