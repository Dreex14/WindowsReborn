<ui:FluentWindow x:Class="WindowsReborn.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure"
                 Title="Windows Reborn"
                 Width="1180" Height="780" MinWidth="960" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Windows Reborn">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navegación lateral -->
            <DockPanel Grid.Column="0" Margin="4,4,0,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="home" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" Margin="0,0,12,0" />
                            <TextBlock Text="{l:Tr nav.home}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBackup" Style="{StaticResource NavItem}" Tag="backup" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Archive24" Margin="0,0,12,0" />
                            <TextBlock Text="{l:Tr nav.backup}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRestore" Style="{StaticResource NavItem}" Tag="restore" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" Margin="0,0,12,0" />
                            <TextBlock Text="{l:Tr nav.restore}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPrograms" Style="{StaticResource NavItem}" Tag="programs" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Apps24" Margin="0,0,12,0" />
                            <TextBlock Text="{l:Tr nav.programs}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <Separator Margin="14,6" Opacity="0.4" />
                    <RadioButton x:Name="NavPersonalization" Style="{StaticResource NavItem}" Tag="personalization" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PaintBrush24" Margin="0,0,12,0" />
                            <TextBlock Text="{l:Tr nav.personalization}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPrivacy" Style="{StaticResource NavItem}" Tag="privacy" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Margin="0,0,12,0" />
                            <TextBlock Text="{l:Tr nav.privacy}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <Separator Margin="14,6" Opacity="0.4" />
                    <RadioButton x:Name="NavPrepare" Style="{StaticResource NavItem}" Tag="prepare" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TaskListSquareLtr24" Margin="0,0,12,0" />
                            <TextBlock Text="{l:Tr nav.prepare}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="settings" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" />
                            <TextBlock Text="{l:Tr nav.settings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>

            <!-- Contenido -->
            <Border Grid.Column="1" Margin="0,0,0,0" CornerRadius="8,0,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <ContentControl x:Name="PageHost" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
