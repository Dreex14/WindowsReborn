<ui:FluentWindow x:Class="WindowsReborn.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:WindowsReborn.App.Infrastructure"
                 Title="Windows Reborn"
                 Width="1240" Height="820" MinWidth="980" MinHeight="660"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Windows Reborn">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,0,12" LastChildFill="False">
                <!-- Marca -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,6,0,18">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentGradient}">
                        <ui:SymbolIcon Symbol="ArrowSync24" Foreground="White" FontSize="22" Filled="True" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows Reborn" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{l:Tr app.tagline}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="home" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" Margin="0,0,14,0" />
                            <TextBlock Text="{l:Tr nav.home}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <Grid Style="{StaticResource NavDivider}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{l:Tr nav.group.before}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" /><Rectangle Grid.Column="1" Height="1" Margin="10,0,0,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" /></Grid>
                    <RadioButton x:Name="NavBackup" Style="{StaticResource NavItem}" Tag="backup" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Archive24" Margin="0,0,14,0" />
                            <TextBlock Text="{l:Tr nav.backup}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <Grid Style="{StaticResource NavDivider}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{l:Tr nav.group.after}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" /><Rectangle Grid.Column="1" Height="1" Margin="10,0,0,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" /></Grid>
                    <RadioButton x:Name="NavRestore" Style="{StaticResource NavItem}" Tag="restore" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowImport24" Margin="0,0,14,0" />
                            <TextBlock Text="{l:Tr nav.restore}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPrograms" Style="{StaticResource NavItem}" Tag="programs" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="AppsAddIn24" Margin="0,0,14,0" />
                            <TextBlock Text="{l:Tr nav.programs}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPrivacy" Style="{StaticResource NavItem}" Tag="privacy" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldLock24" Margin="0,0,14,0" />
                            <TextBlock Text="{l:Tr nav.privacy}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavOptimize" Style="{StaticResource NavItem}" Tag="optimize" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Rocket24" Margin="0,0,14,0" />
                            <TextBlock Text="{l:Tr nav.optimize}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <RadioButton x:Name="NavConfig" Style="{StaticResource NavItem}" Tag="config" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BoxMultiple24" Margin="0,0,14,0" />
                            <TextBlock Text="{l:Tr nav.config}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="26,8,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Column="1" CornerRadius="14,0,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <ContentControl x:Name="PageHost" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
